+def _set_streaming_terminal_scope(profile_home: str, runtime_env: dict, workspace: str):
+    """Bind the profile's TERMINAL_* policy to this turn's context (#5937).
+
+    The os.environ mirror is shared by concurrent turns, so without a scope a
+    turn's tools can run on another profile's backend. Overlay the turn's
+    effective values so behaviour matches the mirror: the profile .env wins
+    over config.yaml, and the session workspace is the cwd. Returns
+    ``(module, token)``; older agents without the scope API return
+    ``(None, None)`` and keep the env mirror.
+    """
+    if not profile_home:
+        return None, None
+    try:
+        from tools import terminal_scope as _ts
+    except Exception:
+        return None, None
+    scope = _ts.prepare_profile_terminal_scope(profile_home)
+    if not isinstance(scope, _ts.TerminalPolicyRefusal):
+        scope = dict(scope)
+        scope.update((k, v) for k, v in runtime_env.items() if k.startswith('TERMINAL_'))
+        scope['TERMINAL_CWD'] = workspace
+    return _ts, _ts.set_terminal_scope(scope)
+
+
+def _reset_streaming_terminal_scope(scope_mod, scope_token) -> None:
+    if scope_mod is None:
+        return
+    try:
+        scope_mod.reset_terminal_scope(scope_token)
+    except Exception:
+        logger.debug("Failed to reset streaming terminal scope", exc_info=True)
+
